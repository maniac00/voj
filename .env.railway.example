# Railway 환경 변수 예시
# Railway 대시보드의 Variables 섹션에 이 값들을 설정하세요

# 환경 설정
ENVIRONMENT=railway

# 데이터베이스 (Railway에서 자동 제공)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis (옵션)
REDIS_URL=${{Redis.REDIS_URL}}

# Railway Volumes
RAILWAY_VOLUME_MOUNT_PATH=/data

# 서버 설정
PORT=${{PORT}}
HOST=0.0.0.0

# CORS 설정 (프론트엔드 URL 추가)
CORS_ORIGINS=https://your-frontend.railway.app,https://your-frontend.vercel.app
ALLOWED_HOSTS=*

# 인증 설정
SIMPLE_AUTH_ENABLED=true
SIMPLE_AUTH_USERNAME=admin
SIMPLE_AUTH_PASSWORD=your_secure_password_here

# 로깅
LOG_LEVEL=INFO

# 프로젝트 정보
PROJECT_NAME=VOJ Audiobooks API
API_V1_STR=/api/v1
