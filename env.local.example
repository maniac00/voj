# 개발 환경 구분
NODE_ENV=development
ENVIRONMENT=local

# 로컬 서버 설정
NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
# 프론트엔드 베이스 URL (선택)
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# 데이터베이스 설정 (로컬: SQLite 기본값 사용 가능)
DATABASE_URL=sqlite:///./voj_dev.db

# 로컬 스토리지
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage/audio
LOCAL_STORAGE_BASE_URL=http://localhost:8080/storage

# 로컬 개발용 JWT 시크릿 (실제 운영에서는 변경 필요)
JWT_SECRET=your-local-jwt-secret-key-change-in-production


# 간단한 인증 설정 (MVP 정적 계정)
# 웹 어드민: admin/qwer1234, 앱: dev@example.com/qwer1234
SIMPLE_AUTH_ENABLED=true
SIMPLE_AUTH_USERNAME=admin
SIMPLE_AUTH_PASSWORD=qwer1234
SIMPLE_AUTH_APP_USERNAME=dev@example.com
SIMPLE_AUTH_APP_PASSWORD=qwer1234

# 로컬 인증 바이패스 설정(개발 편의)
LOCAL_BYPASS_ENABLED=true
LOCAL_BYPASS_SUB=local-dev-user-id
LOCAL_BYPASS_EMAIL=dev@example.com
LOCAL_BYPASS_USERNAME=local.dev
LOCAL_BYPASS_SCOPE=admin
LOCAL_BYPASS_GROUPS=
