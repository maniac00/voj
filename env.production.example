# Backend (Railway)
ENVIRONMENT=production
CORS_ORIGINS=https://voj-audiobooks.vercel.app,https://api.voj-audiobook.com
ALLOWED_HOSTS=voj-audiobooks.vercel.app,api.voj-audiobook.com,*.railway.app

# Database (Railway provides DATABASE_URL)
DATABASE_URL=

# Simple auth credentials (store securely via Railway Variables)
# MVP static accounts:
# - Admin: admin/qwer1234
# - App: dev@example.com/qwer1234
SIMPLE_AUTH_USERNAME=admin
SIMPLE_AUTH_PASSWORD=qwer1234
SIMPLE_AUTH_APP_USERNAME=dev@example.com
SIMPLE_AUTH_APP_PASSWORD=qwer1234

# Frontend integration
NEXT_PUBLIC_API_URL=
